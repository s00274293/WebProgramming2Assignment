@endpoint = http://localhost:3000/api/v1/launches
@missionName = Apollo 7
@rocketName = Rocket Man

###
# @name createLaunch
POST {{endpoint}}
content-type: application/json

{
  "missionName": "{{missionName}}",
  "rocketName": "{{rocketName}}"
}

###
@newLaunch = {{createLaunch.response.body._id}}

###
GET {{endpoint}}/{{newLaunch}}

###
PUT {{endpoint}}/{{newLaunch}}
content-type: application/json

{
  "missionName": "{{missionName}} - Updated",
  "rocketName": "{{rocketName}}",
  "notes": "Suborbital research mission"
}

###
PATCH {{endpoint}}/{{newLaunch}}/favorite
content-type: application/json

{
  "favorite": true
}

###
DELETE {{endpoint}}/{{newLaunch}}